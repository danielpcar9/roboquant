# MetaTrader 5 Credentials - EXNESS
# Demo: Exness-MT5Trial / Real: Exness-MT5Real
MT5_LOGIN=your_account_number
MT5_PASSWORD=your_password
MT5_SERVER=Exness-MT5Trial

# Webhook Configuration
WEBHOOK_SECRET_KEY=your_secret_key_for_webhook_authentication

# Telegram Alerts (optional but recommended)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# API Keys for Event-Driven Trading
TRADINGECONOMICS_KEY=your_key_here
FRED_KEY=your_fred_key_here

# Cache settings (in seconds)
CACHE_TRADINGECONOMICS_TTL=3600  # 1 hour
CACHE_FRED_TTL=21600             # 6 hours
CACHE_FILE_PATH=data/api_cache.json
